# ─── Auth (single user) ──────────────────────────────────────────────
# The one password used to log into the dashboard.
ADMIN_PASSWORD=change-me-please
# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Session lifetime in minutes.
SESSION_EXPIRE_MINUTES=720

# ─── Database ────────────────────────────────────────────────────────
POSTGRES_USER=recongrid
POSTGRES_PASSWORD=recongrid
POSTGRES_DB=recongrid
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Logical DB indexes: broker / result-backend / cache
REDIS_BROKER_DB=0
REDIS_RESULT_DB=1
REDIS_CACHE_DB=2

# ─── Scan execution ──────────────────────────────────────────────────
# Recon tools run directly inside the worker image (mode forced to "local"
# in docker-compose.yml). Hard ceiling (seconds) per tool stage:
TOOL_STAGE_TIMEOUT=1800

# ─── Retention ───────────────────────────────────────────────────────
# Days of inactivity before a "temporary" project is auto-deleted.
TEMP_PROJECT_TTL_DAYS=7
# Keep raw tool output for the most recent N runs per target; prune older.
RAW_OUTPUT_KEEP_RUNS=20

# ─── Frontend ────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Base URL server components use to reach the API (inside the compose network).
API_INTERNAL_BASE_URL=http://api:8000
